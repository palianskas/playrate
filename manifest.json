{
  "manifest_version": 3,
  "name": "Playrate",
  "version": "0.1.0",
  "icons": {
    "16": "res/icon-16.png",
    "32": "res/icon-32.png",
    "48": "res/icon-48.png",
    "128": "res/icon-128.png"
  }, 
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
   {
     "matches": ["https://*.youtube.com/*"],
     "js": ["src/content.js"]
   }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{95123b31-25ca-4a22-8785-2e61d8248110}"
    }
  }
}
